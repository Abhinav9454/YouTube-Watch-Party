# =========================================================================
# MongoDB Atlas Database Credentials Template (Safe for Git)
# =========================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your actual MongoDB Atlas credentials in .env
# 3. .env is ignored by .gitignore and will never be pushed to your repository.

MONGODB_USERNAME=your_mongodb_username_here
MONGODB_PASSWORD=your_mongodb_password_here
MONGODB_CLUSTER=your_cluster.mongodb.net
MONGODB_DATABASE=watchparty
