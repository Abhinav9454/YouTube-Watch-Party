# =========================================================================
# 🔒 Git Ignore Configuration — Keep Passwords & Credentials Safe
# =========================================================================

# Secrets and Environment Variables (NEVER COMMIT)
.env
.env.*
!.env.example
*.secret.properties
application-secret.properties
application-local.properties
secret.properties

# Build & Compilation Output
target/
*.class
*.jar
*.war
*.ear
build/
dist/
dist-ssr/

# Embedded & Local Data
data/
*.db
*.mv.db
*.trace.db

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor Configuration
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary files
*.log
logs/
tmp/
temp/
